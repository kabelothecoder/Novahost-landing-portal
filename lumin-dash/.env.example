# NovaHost backend configuration.
# The VITE_SUPABASE_* names are fixed by the Vercel project settings -- renaming
# them here without renaming them there hands `undefined` to the client.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Android APK download (optional). Falls back to the backend `downloads`
# bucket URL hardcoded in src/pages/Landing.tsx when unset.
VITE_APK_URL=https://your-project-id.supabase.co/storage/v1/object/public/downloads/novahost.apk

# Admin Configuration (Required for Edge Functions)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Partner Integration
PARTNER_SECRET=dev-partner-secret

# MetaAPI Configuration
META_API_TOKEN=your-metaapi-token
