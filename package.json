{
  "name": "novahost-web",
  "version": "0.0.0",
  "private": true,
  "description": "NovaHost web monorepo — marketing landing (Next.js) + mentor portal (Vite), one domain.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/landing",
    "dev:landing": "npm run dev --workspace apps/landing",
    "dev:portal": "npm run dev --workspace apps/portal",
    "build": "npm run build:landing && npm run build:portal",
    "build:landing": "npm run build --workspace apps/landing",
    "build:portal": "npm run build --workspace apps/portal",
    "lint": "npm run lint --workspaces --if-present"
  }
}
