{
  "name": "novahost-web",
  "version": "0.0.0",
  "private": true,
  "description": "NovaHost web monorepo — three separately deployed apps: the marketing landing, the mentor portal, and the admin portal.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/landing",
    "dev:landing": "npm run dev --workspace apps/landing",
    "dev:portal": "npm run dev --workspace apps/portal",
    "dev:admin": "npm run dev --workspace apps/admin",
    "build": "npm run build:landing && npm run build:portal && npm run build:admin",
    "build:landing": "npm run build --workspace apps/landing",
    "build:portal": "npm run build --workspace apps/portal",
    "build:admin": "npm run build --workspace apps/admin",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "overrides": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0"
  }
}
