# All optional — every one of these falls back to the real production value.

# Where the signed Android APK is served from.
VITE_APK_URL=

# Origin of the installable iOS web app. Must be the ONE install origin, or a
# handset that installs from here gets a second device id and burns its licence.
VITE_IOS_APP_URL=

# Set this to show a single discreet "Mentor portal" link in the footer.
# Leave it empty and nothing mentor-facing renders on this site at all.
VITE_PORTAL_URL=
